<div class="navbar navbar-expand-sm navbar-light navbar-spaceships bg-black fixed-top">
  <div class="container-fluid d-flex align-items-center">
  <a class="navbar-brand" href="/spaceships" style="height: 40px; display: flex; align-items: center;">
  <img src="/assets/logo.png" alt="Logo" style="height: 30px; width: auto;">
</a>

    <!-- Centered Search Bar -->
<form action="/spaceships" method="get" class="d-flex align-items-center search-area" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 1000; width: 600px;">
  <span class="me-3 space-label text-white">SEARCH</span>
  <input type="text" name="query" class="form-control bg-dark text-white space-input title-search" style="width: 100%; height: 40px; font-size: 1rem;" placeholder="Search..." value="">
  <button type="submit" class="btn space-button" style="height: 40px; padding: 2 1rem;">
    <i class="fa-solid fa-space-shuttle" style="transform: rotate(90deg);"></i>
  </button>
</form>


    <!-- Navigation Links and Avatar -->
    <div class="d-flex align-items-center ms-auto">
      <ul class="navbar-nav d-flex align-items-center">
        <% if user_signed_in? %>
          <li class="nav-item me-3">
            <a class="nav-link navbar-space-link" href="#">My Account</a>
          </li>
          <li class="nav-item me-3">
            <a data-turbo-method="delete" class="nav-link navbar-space-link" rel="nofollow" data-method="delete" href="/users/sign_out">Log Out</a>
          </li>
          <li class="nav-item dropdown">
            <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <img class="avatar" alt="dropdown menu" src="https://avatars.githubusercontent.com/u/194117812?v=4">
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <a class="dropdown-item" href="#">Action</a>
              <a class="dropdown-item" href="#">Another action</a>
              <a class="dropdown-item" href="/users/sign_out" data-turbo-method="delete">Log out</a>
            </div>
          </li>
        <% else %>
          <li class="nav-item">
            <a class="nav-link navbar-space-link" href="/users/sign_in">Login</a>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
