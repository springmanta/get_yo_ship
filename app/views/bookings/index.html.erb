<div class="container">
  <div class="row justify-content-center">
    <div class="col-12 col-md-9 main-spaceship-container">
      <div class="spaceship-name">
        <h1>Your flights</h1>
      </div>

  <% if @bookings.any? %>

    <% @bookings.each do |booking| %>
      <%= render "mybooking_shipcard", booking: booking  %>
    <% end %>
  <% else %>
    <p>You have no bookings yet.</p>
  <% end %>
</div>
</div>
</div>
