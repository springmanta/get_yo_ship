<div class="spaceship-details">
  <div class="detail-item">
    <strong>Description:</strong> <%= @spaceship.description %>
  </div>
  <div class="detail-item">
    <strong>Capacity:</strong> <%= @spaceship.capacity %> passengers
  </div>
  <div class="detail-item">
    <strong>Made By:</strong> <%= @spaceship.made_by %>
  </div>
  <div class="detail-item">
    <strong>Class:</strong> <%= @spaceship.ship_class %>
  </div>
  <div class="detail-item">
    <strong>Max Speed:</strong> <%= @spaceship.max_speed %>
  </div>
</div>
