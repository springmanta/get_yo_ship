<div class="spaceship-details">
  <div class="detail-item">
    <strong>Description:</strong>
    <span><%= @spaceship.description %></span>
  </div>
  <div class="detail-item">
    <strong>Capacity:</strong>
    <span><%= @spaceship.capacity %> passengers </span>
  </div>
  <div class="detail-item">
    <strong>Made By:</strong>
    <span><%= @spaceship.made_by %></span>
  </div>
  <div class="detail-item">
    <strong>Class:</strong>
    <span><%= @spaceship.ship_class %></span>
  </div>
  <div class="detail-item">
    <strong>Max Speed:</strong>
    <span><%= @spaceship.max_speed %></span>
  </div>
</div>
