
<div class="spaceship-booking">
  <div class="booking-header">
    Book <%= @spaceship.name %>
  </div>
    <%= form_with(model: @booking, local: true) do |f| %>
    <div class="booking-form">
      <div class="form-group">
        <%= f.label :date %>
        <%= f.date_field :date, class: 'form-control' %>
      </div>

      <div class="form-group">
        <%= f.label :guests %>
        <%= f.select :guests, options_for_select(1..@spaceship.capacity), {}, class: 'form-control' %>
      </div>

      <div class="booking-total">
        <strong>Total Price:</strong>
        <span id="total-price">$<%= @spaceship.price %></span>
      </div>

      <%= f.submit "Book Yo Ship", class: "details-button" %>
    </div>
  <% end %>
</div>
