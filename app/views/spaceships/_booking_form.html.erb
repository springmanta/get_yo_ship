
<div class="spaceship-booking">
  <div class="booking-header">
    Book <%= spaceship.name %>
  </div>
    <%= form_with(model: booking, url: spaceship_bookings_path(spaceship), local: true) do |f| %>
    <div class="booking-form">
      <div class="form-group">
        <%= f.label "Date" %>
        <%= f.date_field :booking_date, class: 'form-control' %>
      </div>

      <div class="form-group">
        <%= f.label "Guests" %>
        <%= f.select :guests, options_for_select(1..spaceship.capacity), {}, class: 'form-control' %>
      </div>

      <div class="booking-total">
        <strong>Total Price:</strong>
        <span id="total-price">$<%= spaceship.price %></span>
      </div>

      <%= f.submit "Book Yo Ship", class: "details-button" %>
    </div>
  <% end %>
</div>
