<div class="container">
  <div class="row justify-content-center">
      <div class="col-12 col-md-9 main-spaceship-container">

            <!-- Spaceship Name -->
            <div class="spaceship-name">
              <h1><%= @spaceship.name %></h1>
            </div>


            <!-- Image Carousel -->
            <div id="spaceship-image-carousel" class="carousel slide" data-bs-ride="carousel">
              <!-- Carousel Indicators -->
              <div class="carousel-indicators">
                <button
                  type="button"
                  data-bs-target="#spaceship-image-carousel"
                  data-bs-slide-to="0"
                  class="active"
                  aria-current="true"
                  aria-label="Slide 1">
                  </button>
              </div>

              <!-- Carousel Inner -->
              <div class="carousel-inner">
                <div class="carousel-item active">
                <% @spaceship.photos.each do |photo| %>
                  <%= cl_image_tag photo.key, class: "spaceship-carousel-image"%>
                <% end %>
                </div>
              </div>

              <!-- Carousel Controls -->
              <button
                class="carousel-control-prev"
                type="button"
                data-bs-target="#spaceship-image-carousel"
                data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>

              <button
                class="carousel-control-next"
                type="button"
                data-bs-target="#spaceship-image-carousel"
                data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
          </div>

            <!-- Spaceship Details -->
          <div class="spaceship-content-wrapper">
            <div class="spaceship-left-column">
            <div class="spaceship-details">
              <div class="detail-item">
                <strong>Description:</strong> <%= @spaceship.description %>
              </div>
              <div class="detail-item">
                <strong>Capacity:</strong> <%= @spaceship.capacity %> passengers
              </div>
              <div class="detail-item">
                <strong>Made By:</strong> <%= @spaceship.made_by %>
              </div>
              <div class="detail-item">
                <strong>Class:</strong> <%= @spaceship.ship_class %>
              </div>
              <div class="detail-item">
                <strong>Max Speed:</strong> <%= @spaceship.max_speed %>
              </div>
            </div>
            </div>


            <!-- Right Column: Booking -->
        <div class="spaceship-booking-column">
            <div class="spaceship-booking">
              <div class="booking-header">
                <h3>Fill details to book</h3>
            </div>
            <%= form_with(model: @booking, local: true) do |f| %>
                <div class="booking-form">
                  <div class="form-group">
                    <%= f.label :date %>
                    <%= f.date_field :date, class: 'form-control' %>
                  </div>

                  <div class="form-group">
                    <%= f.label :guests %>
                    <%= f.select :guests, options_for_select(1..@spaceship.capacity), {}, class: 'form-control' %>
                  </div>

                  <div class="booking-total">
                    <strong>Total Price:</strong>
                    <span id="total-price">$<%= @spaceship.price %></span>
                  </div>

                  <%= f.submit "Book Yo Ship", class: "details-button" %>
                </div>
              <% end %>
            </div>
            </div>

         </div>
      </div>
  </div>
</div>
