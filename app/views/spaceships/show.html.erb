<div class="container">
  <div class="row justify-content-center">
    <div class="col-12 col-md-9 main-spaceship-container">

        <!-- Spaceship Name -->
        <div class="spaceship-name">
        <h1><%= @spaceship.name %></h1>
        </div>

        <!-- Render Carousel Partial -->
        <%= render 'spaceships/carousel', spaceship: @spaceship %>

        <!-- About Ship Title -->
        <div class="about-ship-title"> About <%= @spaceship.name %> </div>

        <!-- Spaceship Content Wrapper -->
        <div class="spaceship-content-wrapper">

          <!-- Render Details Partial -->
          <div class="left-column-details">
          <%= render 'spaceships/details', spaceship: @spaceship %>
          </div>

          <!-- Render Booking Form Partial -->
          <div class="right-column-booking">
          <%= render 'spaceships/booking_form', spaceship: @spaceship, booking: @booking %>
          </div>
        </div>
    </div>
  </div>
</div>
